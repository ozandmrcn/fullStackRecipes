          "raw": "{\r\n  \"recipeName\": \"Tavuk Sote\",\r\n  \"category\": \"Ana Yemek\",\r\n  \"ingredients\": [\r\n    \"400 gram tavuk göğsü\",\r\n    \"1 adet soğan\",\r\n    \"2 adet yeşil biber\",\r\n    \"1 adet kırmızı biber\",\r\n    \"2 adet domates\",\r\n    \"3 yemek kaşığı sıvı yağ\",\r\n    \"1 çay kaşığı tuz\",\r\n    \"1 çay kaşığı karabiber\",\r\n    \"1 çay kaşığı pul biber\"\r\n  ],\r\n  \"instructions\": [\r\n    \"Tavuk göğsünü kuşbaşı doğrayın.\",\r\n    \"Soğanı ve biberleri ince ince doğrayın.\",\r\n    \"Tavaya sıvı yağı ekleyip tavukları yüksek ateşte kavurun.\",\r\n    \"Tavuklar suyunu salıp çekince soğan ve biberleri ekleyin.\",\r\n    \"Birkaç dakika kavurduktan sonra doğranmış domatesleri ekleyin.\",\r\n    \"Baharatları ilave edin ve karıştırın.\",\r\n    \"Orta ateşte 10-15 dakika pişirin.\",\r\n    \"Sıcak servis yapın.\"\r\n  ],\r\n  \"recipeTime\": \"25\",\r\n  \"servingSuggestion\": \"Yanında pilav veya makarna ile servis edilebilir.\"\r\n}",
